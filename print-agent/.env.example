# Supabase — copy dari Vercel environment variables
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Nama printer Windows (lihat di Control Panel > Devices and Printers)
# Contoh: "EPSON TM-T82", "Xprinter XP-58", "80mm Thermal"
PRINTER_NAME=EPSON TM-T82

# ID Restoran (sama dengan NEXT_PUBLIC_RESTAURANT_ID di Vercel)
RESTAURANT_ID=your-restaurant-id-here

# URL receipt untuk QR code
APP_URL=https://serasa-opal.vercel.app
